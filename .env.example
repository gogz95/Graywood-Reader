# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR MANHUASYNC / OMNIMANGA TRACKER
# ==============================================================================

# Server Network Configuration
PORT=3000
# Prefer 127.0.0.1 for single-user; use 0.0.0.0 only on trusted LAN or with REQUIRE_AUTH=1
HOST=0.0.0.0
NODE_ENV=production

# Security & PII Encryption
# Strong unique secret (>=32 chars) used for AES-256-GCM PII encryption and auth tokens.
# Required for Docker Compose. Leave unset locally to let the server manage data/.encryption-secret.
ENCRYPTION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Host admin login (username: admin). If unset and admin has no password yet,
# a one-time password is written to data/.admin-bootstrap-password
# ADMIN_PASSWORD=change-me-admin-password

# Require login for non-localhost clients (host/Electron always allowed)
# REQUIRE_AUTH=1
# AUTH_TOKEN_TTL_MS=604800000

# Custom Storage Location for Local CBZ / Offline Manga Files
STORAGE_PATH=./data/storage

# Google Gemini API Key for AI Search & Recommendations (Optional)
# GEMINI_API_KEY=AIzaSy...

# Tracker Subdomain
SUBDOMAIN=tracker.manhuahub.app
