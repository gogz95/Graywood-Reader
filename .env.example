# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION FOR GRAYWOOD READER
# ==============================================================================

# Server Network Configuration
NODE_ENV=production
PORT=3000
# Production default: 127.0.0.1 to enforce reverse-proxy isolation (e.g. Nginx, Caddy, Cloudflare Tunnel)
HOST=127.0.0.1

# Security & PII Encryption
# Strong unique secret (>=32 high-entropy characters) used for AES-256-GCM PII encryption and auth tokens.
# Must be at least 32 characters in length (e.g. generated via `openssl rand -hex 32`).
ENCRYPTION_SECRET=

# Authentication Gate
# Enforce authentication for all non-loopback clients in production environments.
REQUIRE_AUTH=1
AUTH_TOKEN_TTL_MS=604800000

# Persistent Storage Location for Offline Downloads, CBZ / Local Manga Files, and Backups
STORAGE_PATH=/data

# Host admin login (username: admin). If unset and admin has no password yet,
# a one-time bootstrap password is written to data/.admin-bootstrap-password
# ADMIN_PASSWORD=change-me-admin-password

# Google Gemini API Key for AI Search & Recommendations (Optional)
# GEMINI_API_KEY=AIzaSy...

# Tracker Subdomain / Host
SUBDOMAIN=reader.graywood.app
