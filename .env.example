# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR MANHUASYNC / OMNIMANGA TRACKER
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Security & PII Encryption
# Strong unique secret (>=32 chars) used for AES-256-GCM PII encryption.
# Leave unset to let the server manage its own key in data/.encryption-secret.
# ENCRYPTION_SECRET=change-me-to-a-long-random-string

# Custom Storage Location for Local CBZ / Offline Manga Files
# Linux: /var/lib/manhuasync/storage or ./data/storage
# Windows: C:\MangaStorage or ./data/storage
STORAGE_PATH=./data/storage

# Google Gemini API Key for AI Search & Recommendations (Optional)
# GEMINI_API_KEY=AIzaSy...

# Tracker Subdomain
SUBDOMAIN=tracker.manhuahub.app
