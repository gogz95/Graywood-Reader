{
    "name": "graywood-reader",
    "version": "1.0.0",
    "description": "High-performance self-hosted manga, manhwa, and manhua library tracker with a Kotatsu-inspired reader, OPDS 1.2 catalog server, and SQLite WAL storage.",
    "license": "GPL-3.0-or-later",
    "author": "Graywood Reader Contributors",
    "homepage": "https://github.com/gogz95/Remix-ManhuaSync-to-a-reader#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gogz95/Remix-ManhuaSync-to-a-reader.git"
    },
    "bugs": {
        "url": "https://github.com/gogz95/Remix-ManhuaSync-to-a-reader/issues"
    },
    "keywords": [
        "manga",
        "manhwa",
        "manhua",
        "reader",
        "tracker",
        "kotatsu",
        "tachiyomi",
        "mihon",
        "opds",
        "opds-server",
        "self-hosted",
        "sqlite",
        "pwa",
        "webtoon"
    ],
    "main": "electron-main.cjs",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "tsx server.ts",
        "build:server": "esbuild server.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist-server/server.cjs --packages=external",
        "build": "vite build && npm run build:server",
        "start": "node dist-server/server.cjs",
        "start:prod": "node dist-server/server.cjs",
        "pm2:start": "pm2 start ecosystem.config.cjs",
        "docker:build": "docker build -t graywood-reader .",
        "docker:run": "docker compose up -d",
        "deploy:linux": "bash scripts/deploy-linux.sh",
        "deploy:windows": "scripts\\deploy-windows.bat",
        "electron:dev": "electron .",
        "build:exe": "npm run build && electron-builder --win",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build",
        "start:bun": "bun dist-server/server.cjs",
        "preview": "vite preview",
        "lint": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "reader:smoke": "node scripts/reader-smoke.mjs",
        "reader:smoke:source": "node scripts/reader-smoke.mjs --source",
        "liveness:scan": "node scripts/catalog-liveness.mjs",
        "liveness:sample": "node scripts/catalog-liveness.mjs --sample 50",
        "liveness:patch": "node scripts/catalog-liveness.mjs --sample 200 --patch",
        "db:rebuild": "tsx scripts/rebuild-db.ts"
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@tailwindcss/vite": "^4.1.14",
        "adm-zip": "^0.6.0",
        "better-sqlite3": "^13.0.3",
        "cheerio": "^1.2.0",
        "compression": "^1.8.1",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "lucide-react": "^1.31.0",
        "motion": "^13.1.0",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "react-router": "^8.3.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/better-sqlite3": "^9.6.0",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/supertest": "^7.2.1",
        "@vitejs/plugin-react": "^6.0.5",
        "electron": "^43.3.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "supertest": "^7.2.2",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.23.12",
        "typescript": "~5.9.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    }
}
