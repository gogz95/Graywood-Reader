  file_change {
    absolute_path_uri: "file:///src/components/ReaderView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport {\n  MangaItem,\n  ChapterData,\n  ReaderSettings,\n  ReaderViewMode,\n  ReaderBgColor,\n} from \'../types\';\nimport {\n  ArrowLeft,\n  ChevronLeft,\n  ChevronRight,\n  Settings,\n  Maximize,\n  CheckCircle,\n  Sliders,\n  Layers,\n  BookOpen,\n  X,\n  Share2,\n  RefreshCw,\n  Zap,\n} from \'lucide-react\';\n\ninterface ReaderViewProps {\n  manga: MangaItem;\n  initialChapterNumber: number;\n  initialChapterId?: string;\n  onClose: () => void;\n  onMarkChapterRead: (chapterNum: number) => void;\n}\n\nexport const ReaderView: React.FC<ReaderViewProps> = ({\n  manga,\n  initialChapterNumber,\n  initialChapterId,\n  onClose,\n  onMarkChapterRead,\n}) => {\n  const [currentChapterNum, setCurrentChapterNum] = useState<number>(initialChapterNumber || 1);\n  const [chapterData, setChapterData] = useState<ChapterData | null>(null);\n  const [loading, setLoading] = useState<boolean>(true);\n  const [error, setError] = useState<string | null>(null);\n\n  // Single page mode current index\n  const [singlePageIndex, setSinglePageIndex] = useState<number>(0);\n\n  // Settings state\n  const [showSettings, setShowSettings] = useState<boolean>(false);\n  const [showChapterMenu, setShowChapterMenu] = useState<boolean>(false);\n  const [settings, setSettings] = useState<ReaderSettings>({\n    viewMode: \'webtoon\',\n    maxWidth: \'800px\',\n    pageGap: 8,\n    bgColor: \'slate\',\n    zoomLevel: 100,\n    autoMarkRead: true,\n  });\n\n  // Scroll progress tracking\n  const scrollContainerRef = useRef<HTMLDivElement>(null);\n  const [readProgressPercent, setReadProgressPercent] = useState<number>(0);\n\n  // Fetch chapter page image URLs\n  const fetchChapterPages = async (chNum: number) => {\n    setLoading(true);\n    setError(null);\n    setSinglePageIndex(0);\n\n    try {\n      const url = `/api/reader/chapter-pages?mangaId=${encodeURIComponent(\n        manga.id\n      )}&chapterNumber=${chNum}${initialChapterId ? `&chapterId=${encodeURIComponent(initialChapterId)}` : \'\'}`;\n      const res = await fetch(url);\n      if (!res.ok) throw new Error(\'Failed to load chapter content\');\n      const data: ChapterData = await res.json();\n      setChapterData(data);\n\n      // Auto mark read if configured\n      if (settings.autoMarkRead) {\n        onMarkChapterRead(chNum);\n      }\n    } catch (err: any) {\n      console.error(err);\n      setError(\'Could not load chapter pages. Please try again.\');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchChapterPages(currentChapterNum);\n  }, [currentChapterNum]);\n\n  // Handle Scroll Progress for Webtoon View\n  const handleScroll = () => {\n    if (!scrollContainerRef.current) return;\n    const { scrollTop, scrollHeight, clientHeight } = scrollContainerRef.current;\n    if (scrollHeight <= clientHeight) {\n      setReadProgressPercent(100);\n      return;\n    }\n    const percent = Math.min(100, Math.round((scrollTop / (scrollHeight - clientHeight)) * 100));\n    setReadProgressPercent(percent);\n\n    if (percent > 85 && settings.autoMarkRead) {\n      onMarkChapterRead(currentChapterNum);\n    }\n  };\n\n  // Keyboard shortcut listener for arrow keys navigation\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'ArrowRight\' || e.key === \'d\') {\n        if (settings.viewMode === \'single\' && chapterData) {\n          if (singlePageIndex < chapterData.pages.length - 1) {\n            setSinglePageIndex((prev) => prev + 1);\n          } else if (chapterData.nextChapterNumber) {\n            setCurrentChapterNum(chapterData.nextChapterNumber);\n          }\n        }\n      } else if (e.key === \'ArrowLeft\' || e.key === \'a\') {\n        if (settings.viewMode === \'single\' && chapterData) {\n          if (singlePageIndex > 0) {\n            setSinglePageIndex((prev) => prev - 1);\n          } else if (chapterData.prevChapterNumber) {\n            setCurrentChapterNum(chapterData.prevChapterNumber);\n          }\n        }\n      } else if (e.key === \'f\') {\n        // Toggle Fullscreen\n        if (!document.fullscreenElement) {\n          document.documentElement.requestFullscreen().catch(() => {});\n        } else {\n          document.exitFullscreen().catch(() => {});\n        }\n      }\n    };\n\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [settings.viewMode, singlePageIndex, chapterData]);\n\n  // Background color style mapping\n  const bgStyleClass =\n    settings.bgColor === \'black\'\n      ? \'bg-black text-slate-100\'\n      : settings.bgColor === \'charcoal\'\n      ? \'bg-zinc-950 text-slate-100\'\n      : \'bg-slate-950 text-slate-100\';\n\n  const totalChaptersList = Array.from(\n    { length: Math.max(manga.latestChapter, manga.currentChapter, 10) },\n    (_, i) => i + 1\n  ).reverse();\n\n  return (\n    <div className={`fixed inset-0 z-50 flex flex-col ${bgStyleClass} font-sans select-none overflow-hidden`}>\n      {/* Top Fixed Reader Header Bar */}\n      <header className=\"sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800/90 text-slate-100 px-4 py-2.5 flex items-center justify-between gap-2 shadow-xl\">\n        <div className=\"flex items-center gap-3 min-w-0\">\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white transition-all flex items-center gap-1.5 text-xs font-bold\"\n            title=\"Return to Library\"\n          >\n            <ArrowLeft className=\"w-4 h-4\" />\n            <span className=\"hidden sm:inline\">Exit</span>\n          </button>\n\n          <div className=\"min-w-0\">\n            <h2 className=\"text-sm font-bold text-slate-100 truncate hover:text-amber-400 transition-colors\">\n              {manga.title}\n            </h2>\n            <div className=\"flex items-center gap-2 text-xs text-slate-400 font-medium\">\n              <span className=\"text-amber-400 font-bold\">Ch. {currentChapterNum}</span>\n              <span>\342\200\242</span>\n              <span className=\"truncate\">{chapterData?.scanGroup || manga.sourceName || \'Scanlation\'}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Center Chapter Selector & Navigation Controls */}\n        <div className=\"flex items-center gap-1.5\">\n          <button\n            disabled={!chapterData?.prevChapterNumber}\n            onClick={() => chapterData?.prevChapterNumber && setCurrentChapterNum(chapterData.prevChapterNumber)}\n            className=\"p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 disabled:opacity-30 disabled:pointer-events-none text-slate-200 transition-all\"\n            title=\"Previous Chapter\"\n          >\n            <ChevronLeft className=\"w-4 h-4\" />\n          </button>\n\n          {/* Quick Chapter Selector Dropdown */}\n          <div className=\"relative\">\n            <button\n              onClick={() => setShowChapterMenu(!showChapterMenu)}\n              className=\"px-3 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-amber-400 font-bold text-xs flex items-center gap-1.5 hover:bg-slate-750 transition-all\"\n            >\n              <span>Ch. {currentChapterNum}</span>\n              <BookOpen className=\"w-3.5 h-3.5 text-slate-400\" />\n            </button>\n\n            {showChapterMenu && (\n              <div className=\"absolute top-full mt-2 left-1/2 -translate-x-1/2 w-48 max-h-64 overflow-y-auto bg-slate-900 border border-slate-700 rounded-xl shadow-2xl p-1 z-50 space-y-0.5\">\n                <div className=\"p-2 text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-800\">\n                  Select Chapter\n                </div>\n                {totalChaptersList.map((ch) => (\n                  <button\n                    key={ch}\n                    onClick={() => {\n                      setCurrentChapterNum(ch);\n                      setShowChapterMenu(false);\n                    }}\n                    className={`w-full text-left px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center justify-between ${\n                      ch === currentChapterNum\n                        ? \'bg-amber-500 text-slate-950 font-bold\'\n                        : \'text-slate-300 hover:bg-slate-800\'\n                    }`}\n                  >\n                    <span>Chapter {ch}</span>\n                    {ch <= manga.currentChapter && ch !== currentChapterNum && (\n                      <CheckCircle className=\"w-3 h-3 text-emerald-400\" />\n                    )}\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n\n          <button\n            disabled={!chapterData?.nextChapterNumber}\n            onClick={() => chapterData?.nextChapterNumber && setCurrentChapterNum(chapterData.nextChapterNumber)}\n            className=\"p-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold disabled:opacity-30 disabled:pointer-events-none transition-all\"\n            title=\"Next Chapter\"\n          >\n            <ChevronRight className=\"w-4 h-4 stroke-[3]\" />\n          </button>\n        </div>\n\n        {/* Right Action Tools: Settings, Fullscreen */}\n        <div className=\"flex items-center gap-1.5\">\n          <button\n            onClick={() => setShowSettings(!showSettings)}\n            className={`p-2 rounded-lg transition-all ${\n              showSettings ? \'bg-amber-500 text-slate-950 font-bold\' : \'bg-slate-800/80 text-slate-300 hover:bg-slate-700\'\n            }`}\n            title=\"Reader Display Settings\"\n          >\n            <Sliders className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={() => {\n              if (!document.fullscreenElement) {\n                document.documentElement.requestFullscreen().catch(() => {});\n              } else {\n                document.exitFullscreen().catch(() => {});\n              }\n            }}\n            className=\"p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 hidden sm:block\"\n            title=\"Toggle Fullscreen Mode (F)\"\n          >\n            <Maximize className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </header>\n\n      {/* Top Reading Progress Bar */}\n      <div className=\"w-full h-1 bg-slate-900 relative\">\n        <div\n          className=\"h-full bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 transition-all duration-150\"\n          style={{ width: `${readProgressPercent}%` }}\n        />\n      </div>\n\n      {/* READER DISPLAY SETTINGS MODAL / PANEL */}\n      {showSettings && (\n        <div className=\"absolute top-14 right-4 z-50 w-80 bg-slate-900 border border-slate-700 rounded-2xl shadow-2xl p-4 space-y-4 text-xs\">\n          <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n            <div className=\"font-bold text-slate-200 text-sm flex items-center gap-2\">\n              <Sliders className=\"w-4 h-4 text-amber-400\" />\n              Reader Customizations\n            </div>\n            <button onClick={() => setShowSettings(false)} className=\"text-slate-400 hover:text-white\">\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* View Mode Choice */}\n          <div className=\"space-y-1.5\">\n            <label className=\"font-bold text-slate-300\">Layout Reading Mode:</label>\n            <div className=\"grid grid-cols-3 gap-1.5\">\n              <button\n                onClick={() => setSettings({ ...settings, viewMode: \'webtoon\' })}\n                className={`py-2 px-2 rounded-lg font-bold border transition-all ${\n                  settings.viewMode === \'webtoon\'\n                    ? \'bg-amber-500 text-slate-950 border-amber-400\'\n                    : \'bg-slate-950 text-slate-300 border-slate-800 hover:bg-slate-800\'\n                }`}\n              >\n                Webtoon (Long Strip)\n              </button>\n              <button\n                onClick={() => setSettings({ ...settings, viewMode: \'single\' })}\n                className={`py-2 px-2 rounded-lg font-bold border transition-all ${\n                  settings.viewMode === \'single\'\n                    ? \'bg-amber-500 text-slate-950 border-amber-400\'\n                    : \'bg-slate-950 text-slate-300 border-slate-800 hover:bg-slate-800\'\n                }`}\n              >\n                Single Page\n              </button>\n              <button\n                onClick={() => setSettings({ ...settings, viewMode: \'double\' })}\n                className={`py-2 px-2 rounded-lg font-bold border transition-all ${\n                  settings.viewMode === \'double\'\n                    ? \'bg-amber-500 text-slate-950 border-amber-400\'\n                    : \'bg-slate-950 text-slate-300 border-slate-800 hover:bg-slate-800\'\n                }`}\n              >\n                Double Spread\n              </button>\n            </div>\n          </div>\n\n          {/* Strip Width Constraint */}\n          <div className=\"space-y-1.5\">\n            <label className=\"font-bold text-slate-300\">Webtoon Strip Max-Width:</label>\n            <div className=\"grid grid-cols-4 gap-1\">\n              {[\'700px\', \'850px\', \'1000px\', \'100%\'].map((w) => (\n                <button\n                  key={w}\n                  onClick={() => setSettings({ ...settings, maxWidth: w })}\n                  className={`py-1.5 rounded-md font-bold text-[11px] border ${\n                    settings.maxWidth === w\n                      ? \'bg-amber-500 text-slate-950 border-amber-400\'\n                      : \'bg-slate-950 text-slate-300 border-slate-800\'\n                  }`}\n                >\n                  {w}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Background Theme */}\n          <div className=\"space-y-1.5\">\n            <label className=\"font-bold text-slate-300\">Background Canvas Theme:</label>\n            <div className=\"grid grid-cols-3 gap-1.5\">\n              <button\n                onClick={() => setSettings({ ...settings, bgColor: \'slate\' })}\n                className={`py-1.5 rounded-lg font-bold border ${\n                  settings.bgColor === \'slate\'\n                    ? \'bg-slate-800 text-amber-400 border-amber-500\'\n                    : \'bg-slate-950 text-slate-400 border-slate-800\'\n                }`}\n              >\n                Deep Slate\n              </button>\n              <button\n                onClick={() => setSettings({ ...settings, bgColor: \'black\' })}\n                className={`py-1.5 rounded-lg font-bold border ${\n                  settings.bgColor === \'black\'\n                    ? \'bg-black text-amber-400 border-amber-500\'\n                    : \'bg-slate-950 text-slate-400 border-slate-800\'\n                }`}\n              >\n                Pitch Black\n              </button>\n              <button\n                onClick={() => setSettings({ ...settings, bgColor: \'charcoal\' })}\n                className={`py-1.5 rounded-lg font-bold border ${\n                  settings.bgColor === \'charcoal\'\n                    ? \'bg-zinc-900 text-amber-400 border-amber-500\'\n                    : \'bg-slate-950 text-slate-400 border-slate-800\'\n                }`}\n              >\n                Charcoal\n              </button>\n            </div>\n          </div>\n\n          {/* Page Gap */}\n          <div className=\"space-y-1\">\n            <div className=\"flex justify-between font-bold text-slate-300\">\n              <span>Page Gap:</span>\n              <span className=\"text-amber-400\">{settings.pageGap}px</span>\n            </div>\n            <input\n              type=\"range\"\n              min=\"0\"\n              max=\"32\"\n              step=\"4\"\n              value={settings.pageGap}\n              onChange={(e) => setSettings({ ...settings, pageGap: Number(e.target.value) })}\n              className=\"w-full accent-amber-500\"\n            />\n          </div>\n        </div>\n      )}\n\n      {/* MAIN READER SCROLL CONTAINER */}\n      <main\n        ref={scrollContainerRef}\n        onScroll={handleScroll}\n        className=\"flex-1 overflow-y-auto overflow-x-hidden p-0 relative\"\n      >\n        {loading ? (\n          <div className=\"min-h-[70vh] flex flex-col items-center justify-center p-8 space-y-4 text-center\">\n            <div className=\"w-12 h-12 border-4 border-amber-500 border-t-transparent rounded-full animate-spin\" />\n            <div className=\"space-y-1\">\n              <h3 className=\"text-lg font-bold text-slate-100\">Fetching Chapter {currentChapterNum}...</h3>\n              <p className=\"text-xs text-slate-400\">Loading scanlation webtoon page images...</p>\n            </div>\n          </div>\n        ) : error ? (\n          <div className=\"min-h-[70vh] flex flex-col items-center justify-center p-8 space-y-4 text-center max-w-md mx-auto\">\n            <div className=\"w-12 h-12 rounded-2xl bg-red-500/10 text-red-400 border border-red-500/20 flex items-center justify-center\">\n              <X className=\"w-6 h-6\" />\n            </div>\n            <h3 className=\"text-base font-bold text-slate-200\">{error}</h3>\n            <button\n              onClick={() => fetchChapterPages(currentChapterNum)}\n              className=\"px-4 py-2 rounded-xl bg-amber-500 text-slate-950 font-bold text-xs flex items-center gap-2\"\n            >\n              <RefreshCw className=\"w-4 h-4\" />\n              Retry Chapter\n            </button>\n          </div>\n        ) : chapterData && settings.viewMode === \'webtoon\' ? (\n          /* WEBTOON VERTICAL LONG STRIP MODE */\n          <div className=\"flex flex-col items-center w-full py-4 space-y-0\">\n            <div\n              className=\"w-full mx-auto flex flex-col items-center shadow-2xl\"\n              style={{ maxWidth: settings.maxWidth, gap: `${settings.pageGap}px` }}\n            >\n              {chapterData.pages.map((pageSrc, idx) => (\n                <div key={idx} className=\"w-full relative bg-slate-950 overflow-hidden\">\n                  <img\n                    src={pageSrc}\n                    alt={`Page ${idx + 1}`}\n                    className=\"w-full h-auto block object-contain\"\n                    loading={idx < 3 ? \'eager\' : \'lazy\'}\n                  />\n                  <div className=\"absolute bottom-2 right-2 px-2 py-0.5 rounded bg-slate-950/80 backdrop-blur-md text-[10px] text-slate-400 font-mono\">\n                    Page {idx + 1} / {chapterData.pages.length}\n                  </div>\n                </div>\n              ))}\n\n              {/* End of Chapter Navigation Card */}\n              <div className=\"w-full p-8 my-8 bg-slate-900 border border-slate-800 rounded-2xl text-center space-y-4 max-w-lg mx-auto shadow-2xl\">\n                <div className=\"w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center mx-auto\">\n                  <CheckCircle className=\"w-6 h-6\" />\n                </div>\n\n                <div className=\"space-y-1\">\n                  <h3 className=\"text-xl font-black text-slate-100\">\n                    Finished Chapter {currentChapterNum}\n                  </h3>\n                  <p className=\"text-xs text-slate-400\">\n                    Chapter marked as read in your tracker library.\n                  </p>\n                </div>\n\n                <div className=\"flex flex-col sm:flex-row items-center justify-center gap-3 pt-2\">\n                  <button\n                    onClick={onClose}\n                    className=\"w-full sm:w-auto px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs\"\n                  >\n                    Back to Library\n                  </button>\n\n                  {chapterData.nextChapterNumber && (\n                    <button\n                      onClick={() => setCurrentChapterNum(chapterData.nextChapterNumber!)}\n                      className=\"w-full sm:w-auto px-6 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold text-xs shadow-lg flex items-center justify-center gap-2\"\n                    >\n                      <span>Read Chapter {chapterData.nextChapterNumber}</span>\n                      <ChevronRight className=\"w-4 h-4 stroke-[3]\" />\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        ) : chapterData && settings.viewMode === \'single\' ? (\n          /* SINGLE PAGE MODE WITH KEYBOARD & TAP NAV */\n          <div className=\"min-h-[85vh] flex flex-col items-center justify-center p-4\">\n            <div\n              className=\"relative w-full mx-auto flex flex-col items-center\"\n              style={{ maxWidth: settings.maxWidth }}\n            >\n              <img\n                src={chapterData.pages[singlePageIndex]}\n                alt={`Page ${singlePageIndex + 1}`}\n                className=\"w-full h-auto max-h-[80vh] object-contain rounded-xl shadow-2xl\"\n              />\n\n              {/* Tap Left / Right Overlay Controls */}\n              <div\n                onClick={() => setSinglePageIndex((prev) => Math.max(0, prev - 1))}\n                className=\"absolute left-0 top-0 bottom-0 w-1/3 cursor-pointer hover:bg-amber-500/5 transition-colors flex items-center justify-start pl-4\"\n                title=\"Previous Page (A or Left Arrow)\"\n              >\n                <div className=\"p-3 rounded-full bg-slate-900/80 text-slate-300 opacity-0 hover:opacity-100 transition-opacity\">\n                  <ChevronLeft className=\"w-6 h-6\" />\n                </div>\n              </div>\n\n              <div\n                onClick={() => {\n                  if (singlePageIndex < chapterData.pages.length - 1) {\n                    setSinglePageIndex((prev) => prev + 1);\n                  } else if (chapterData.nextChapterNumber) {\n                    setCurrentChapterNum(chapterData.nextChapterNumber);\n                  }\n                }}\n                className=\"absolute right-0 top-0 bottom-0 w-1/3 cursor-pointer hover:bg-amber-500/5 transition-colors flex items-center justify-end pr-4\"\n                title=\"Next Page (D or Right Arrow)\"\n              >\n                <div className=\"p-3 rounded-full bg-amber-500/90 text-slate-950 opacity-0 hover:opacity-100 transition-opacity\">\n                  <ChevronRight className=\"w-6 h-6 stroke-[3]\" />\n                </div>\n              </div>\n            </div>\n\n            {/* Bottom Single Page Navigation */}\n            <div className=\"mt-4 flex items-center gap-4 text-xs font-bold bg-slate-900 border border-slate-800 px-4 py-2 rounded-xl\">\n              <button\n                disabled={singlePageIndex === 0}\n                onClick={() => setSinglePageIndex((prev) => Math.max(0, prev - 1))}\n                className=\"text-slate-300 hover:text-amber-400 disabled:opacity-30\"\n              >\n                Previous Page\n              </button>\n              <span className=\"text-amber-400\">\n                Page {singlePageIndex + 1} of {chapterData.pages.length}\n              </span>\n              <button\n                onClick={() => {\n                  if (singlePageIndex < chapterData.pages.length - 1) {\n                    setSinglePageIndex((prev) => prev + 1);\n                  } else if (chapterData.nextChapterNumber) {\n                    setCurrentChapterNum(chapterData.nextChapterNumber);\n                  }\n                }}\n                className=\"text-slate-300 hover:text-amber-400\"\n              >\n                Next Page\n              </button>\n            </div>\n          </div>\n        ) : (\n          /* DOUBLE SPREAD MODE */\n          <div className=\"min-h-[85vh] flex flex-col items-center justify-center p-4\">\n            <div className=\"flex gap-2 max-w-5xl mx-auto items-center justify-center\">\n              {chapterData?.pages[singlePageIndex] && (\n                <img\n                  src={chapterData.pages[singlePageIndex]}\n                  alt=\"Left Page\"\n                  className=\"w-1/2 h-auto max-h-[80vh] object-contain rounded-lg shadow-xl\"\n                />\n              )}\n              {chapterData?.pages[singlePageIndex + 1] && (\n                <img\n                  src={chapterData.pages[singlePageIndex + 1]}\n                  alt=\"Right Page\"\n                  className=\"w-1/2 h-auto max-h-[80vh] object-contain rounded-lg shadow-xl\"\n                />\n              )}\n            </div>\n          </div>\n        )}\n      </main>\n    </div>\n  );\n};\n"
